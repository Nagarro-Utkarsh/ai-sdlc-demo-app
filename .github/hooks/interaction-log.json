{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "python3 .github/hooks/interaction_log.py userPromptSubmitted",
        "powershell": "python .github/hooks/interaction_log.py userPromptSubmitted",
        "cwd": ".",
        "timeoutSec": 5
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "python3 .github/hooks/interaction_log.py agentStop",
        "powershell": "python .github/hooks/interaction_log.py agentStop",
        "cwd": ".",
        "timeoutSec": 5
      }
    ]
  }
}
