{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "python3 .github/hooks/interaction_log.py",
        "powershell": "python .github/hooks/interaction_log.py",
        "cwd": ".",
        "timeoutSec": 5
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "python3 .github/hooks/interaction_log.py",
        "powershell": "python .github/hooks/interaction_log.py",
        "cwd": ".",
        "timeoutSec": 5
      }
    ],
    "postToolUseFailure": [
      {
        "type": "command",
        "bash": "python3 .github/hooks/interaction_log.py",
        "powershell": "python .github/hooks/interaction_log.py",
        "cwd": ".",
        "timeoutSec": 5
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "python3 .github/hooks/interaction_log.py",
        "powershell": "python .github/hooks/interaction_log.py",
        "cwd": ".",
        "timeoutSec": 5
      }
    ],
    "subagentStart": [
      {
        "type": "command",
        "bash": "python3 .github/hooks/interaction_log.py",
        "powershell": "python .github/hooks/interaction_log.py",
        "cwd": ".",
        "timeoutSec": 5
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "bash": "python3 .github/hooks/interaction_log.py",
        "powershell": "python .github/hooks/interaction_log.py",
        "cwd": ".",
        "timeoutSec": 5
      }
    ]
  }
}
